<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Voice input. Required once the hardened runtime is on, which
	     notarization in turn requires. Screen Recording is governed by TCC
	     alone and needs no entitlement. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
